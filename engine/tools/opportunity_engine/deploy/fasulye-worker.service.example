# Example only. No installation or activation performed.
[Unit]
Description=Fasulye standalone research worker
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=fasulye
WorkingDirectory=/opt/fasulye
EnvironmentFile=/etc/fasulye/worker.env
ExecStart=/usr/bin/python3 -m engine.tools.opportunity_engine.standalone_worker --poll-seconds 300
Restart=on-failure
RestartSec=60
TimeoutStopSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
